# Supabase Configuration
# Replace with your actual project URL and public Publishable / Anon Key from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Google Gemini API Key (optional for client-side fallback; edge functions use server secret)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

